# Copy to .env for local development. NEVER commit the real .env.
# On Render, set these under the service's "Environment" tab instead.

# --- runtime ---
NODE_ENV=development
PORT=3000
LOG_LEVEL=info
# Public https URL of this app. On Render this can be omitted (RENDER_EXTERNAL_URL is used).
# Locally, set it to your tunnel URL (see README) so the "Connect server" redirect works.
PUBLIC_BASE_URL=http://localhost:3000

# --- database (Neon / Supabase / any Postgres) ---
# Neon: paste the connection string as-is (sslmode=require is honoured, channel_binding is ignored).
# Local zero-install option: `npm run db:local` then use the line below with DATABASE_POOL_MAX=1.
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5433/postgres
DATABASE_POOL_MAX=1

# 32+ random characters. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
APP_SECRET=replace-me-with-64-hex-chars-from-the-command-above-000000000

# --- Discord Developer Portal (https://discord.com/developers/applications) ---
# General Information -> Application ID / Public Key
DISCORD_APPLICATION_ID=
DISCORD_PUBLIC_KEY=
# Bot -> Reset Token
DISCORD_BOT_TOKEN=
# OAuth2 -> Client Secret (Reset Secret)
DISCORD_CLIENT_SECRET=

# --- AI triage (optional; free Groq key from https://console.groq.com/keys, no card) ---
# Without a key the bot uses deterministic keyword triage.
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant

# --- dashboard login ---
# Created/updated on every boot. Use this as the throwaway reviewer account.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-please
# Allow anyone to create an admin account at /signup (each admin only sees servers they connected).
ALLOW_SIGNUP=false

# Self-ping every 10 min so a free Render instance never sleeps (Discord doesn't retry a timed-out interaction).
KEEPALIVE=true
