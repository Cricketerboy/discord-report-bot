{
  "name": "discord-report-bot",
  "version": "1.0.0",
  "private": true,
  "description": "Discord slash-command bot (HTTP interactions) with a login-protected dashboard, durable job queue, Slack/Discord mirroring and AI triage.",
  "type": "module",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "db:migrate": "tsx --env-file-if-exists=.env scripts/migrate.ts",
    "db:local": "pglite-server --db=.data/pglite --port=5433",
    "commands:register": "tsx --env-file-if-exists=.env scripts/register-commands.ts",
    "probe": "tsx --env-file-if-exists=.env scripts/probe.ts",
    "test": "tsx --test test/unit/*.test.ts",
    "test:e2e": "tsx --test --test-concurrency=1 test/e2e/*.test.ts",
    "test:all": "npm run test && npm run test:e2e"
  },
  "dependencies": {
    "cookie-parser": "^1.4.7",
    "express": "^5.1.0",
    "helmet": "^8.1.0",
    "pg": "^8.16.3",
    "pino": "^9.9.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.3.7",
    "@electric-sql/pglite-socket": "^0.0.14",
    "@types/cookie-parser": "^1.4.9",
    "@types/express": "^5.0.3",
    "@types/node": "^22.18.0",
    "@types/pg": "^8.15.5",
    "pino-pretty": "^13.1.1",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  }
}
